# LLM Provider: "mock" (default, no key needed) or "openai"
LLM_PROVIDER=mock

# Only required if LLM_PROVIDER=openai — never commit a real key
OPENAI_API_KEY=

# Ports (defaults used if not set)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Path to the dataset (relative to backend/)
DATA_PATH=../data/runs.jsonl
